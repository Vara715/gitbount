# Optional but recommended. Raises the GitHub API limit (60 -> 5000/h) and unlocks
# commit / PR / review / issue / consistency signals (GraphQL needs a token).
# A token with NO scopes (public data only) is enough.
GITHUB_TOKEN=
# Used for absolute Open Graph URLs, e.g. https://githubbounty.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leaderboard storage. Leave these empty locally (a ./.data JSON file is used).
# On Vercel, adding the Upstash Redis integration fills these in automatically
# (it may name them KV_REST_API_URL / KV_REST_API_TOKEN, which are also supported).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Only for the local JSON fallback / Docker volume (default ./.data)
DATA_DIR=
